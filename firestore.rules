rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Curated catalog: signed-in clients can fetch this published document.
    // Publishing and editing templates require trusted administrative access.
    match /planTemplates/{templateId} {
      allow get: if request.auth != null && templateId == 'catalog-v1' && resource.data.published == true;
      allow list, write: if false;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
