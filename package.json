{
  "name": "repday-workout-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "deploy:web:preview": "npx eas-cli@latest env:exec preview 'npm run export:web' && npx eas-cli@latest deploy --environment preview",
    "deploy:web:prod": "npx eas-cli@latest env:exec production 'npm run export:web' && npx eas-cli@latest deploy --environment production --prod",
    "update:preview": "npx eas-cli@latest update --channel preview --environment production",
    "update:prod": "npx eas-cli@latest update --channel production --environment production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ui": "^57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/ai": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.21",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "^57.0.22",
    "expo-router": "~57.0.24",
    "expo-sharing": "^57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "expo-widgets": "^57.0.23",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
