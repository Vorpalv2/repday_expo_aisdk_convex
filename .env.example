# Convex development deployment values (created by `npx convex dev`).
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Firebase app configuration for a future Firebase build. The Firebase adapter
# is not implemented yet; these values are not read by the current app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Server-side Vercel AI Gateway credentials. Never use EXPO_PUBLIC_ for this key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=inclusionai/ling-3.1-flash

# For a native production build, set this to the deployed Expo API origin.
# Expo development uses the host running the development server automatically.
EXPO_PUBLIC_API_URL=
