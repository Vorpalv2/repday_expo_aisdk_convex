# Firebase web app configuration. These client values are public; protect data
# with Firebase Authentication and Firestore/Storage Security Rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase AI Logic uses the Gemini Developer API. The model name is configurable
# so it can be changed without editing screens; Firebase AI Logic still needs to
# be provisioned for this Firebase project.
EXPO_PUBLIC_FIREBASE_AI_MODEL=gemini-3.5-flash

# Register this reCAPTCHA Enterprise site key for the web app in Firebase App Check.
# Local development uses App Check's debug provider instead.
EXPO_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
