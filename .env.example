# Firebase web app configuration. These client values are public; protect data
# with Firebase Authentication and Firestore/Storage Security Rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Server-side Vercel AI Gateway credentials. Never expose this with EXPO_PUBLIC_.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-mini

# Server-side Upstash Redis REST credentials for shared AI rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Native app requests use this deployed API origin; development discovers the Metro host.
EXPO_PUBLIC_API_URL=https://repday.expo.app

# Web Push: server-side configuration (public key is returned by /api/push).
# Generate the key pair with npm run push:keys. Keep the same pair across releases.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Your real support email (mailto:you@example.com) or public contact-page URL.
WEB_PUSH_SUBJECT=https://repday.expo.app
# Exact HTTPS origin of this deployment, with no trailing slash.
WEB_PUSH_ORIGIN=https://repday.expo.app

# Upstash QStash delayed delivery. Separate from the Redis REST credentials.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
